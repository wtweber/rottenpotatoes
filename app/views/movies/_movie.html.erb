<h1 class='title-case'><%= movie.title%></h1>
<div id="<%= dom_id movie %>" class='body-case'>
  <div>
    <strong>Title:</strong>
    <%= movie.title %>
  </div>

  <div>
    <strong>Rating:</strong>
    <%= movie.rating %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= movie.description %>
  </div>

  <div>
    <strong>Release date:</strong>
    <%= movie.release_date.strftime('%B %d, %Y') %>
  </div>

</div>
