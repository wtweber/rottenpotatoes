<p style="color: green"><%= notice %></p>

<%= render @movie %>

<div class="padded">
  <%= link_to "Edit this movie", edit_movie_path(@movie), class: "styled-button" %> |
  <%= link_to "Back to movies", movies_path, class: "styled-button" %>
</div>
<div class="padded">
  <%= button_to "Destroy this movie", @movie, method: :delete, class: "destroy-button" %>
</div>
