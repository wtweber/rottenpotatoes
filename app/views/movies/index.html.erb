<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<div id="movies">
  <table>
    <thread>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Rating</th>
        <th scope="col">Release Date</th>
      </tr>
    </thread>
    <tbody>
      <% @movies.each do |movie| %>
      <%= render movie %>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New movie", new_movie_path %>
