<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<div id="movies">
  <table class='styled-table'>
    <thread>
      <tr>
        <th><%= link_to 'Title', :sort => 'title' %></th>
        <th><%= link_to 'Rating', :sort => 'rating' %></th>
        <th><%= link_to 'Release', :sort => 'release_date' %></th>
      </tr>
    </thread>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td scope="row"><%= link_to movie.title, movie %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date.strftime('%B %d, %Y') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class='padded'>
  <%= link_to 'New movie', new_movie_path, class: 'styled-button' %>
</div>