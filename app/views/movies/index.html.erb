<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1 class="title-case">Movies</h1>

<div id="movies">
  <table class="styled-table">
    <colgroup>
      <col class="<%= columnFormat 'title' %>" />
      <col class="<%= columnFormat 'rating' %>" />
      <col class="<%= columnFormat 'release_date' %>" />
    </colgroup>
    <thread>
      <tr>
        <th><%= sortable 'title', 'Title' %></th>
        <th><%= sortable 'rating', 'Rating' %></th>
        <th><%= sortable 'release_date', 'Release' %></th>
      </tr>
    </thread>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td scope="row"><%= link_to movie.title, movie %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date.strftime("%B %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="padded">
  <%= link_to "New movie", new_movie_path, class: "styled-button" %>
</div>